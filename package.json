{
  "name": "dsh-process-tree",
  "version": "0.10.0",
  "description": "Configurable process trees with classic curves, botanical artwork, quiet lines and IDE task functions.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/COMPATIBILITY.md",
    "docs/DISCOVER.md",
    "docs/verification/0.7.2.json",
    "docs/verification/0.7.3.json",
    "docs/images/classic.png",
    "docs/images/quiet.png",
    "docs/images/botanical.png",
    "docs/images/process-tree-styles.png",
    "docs/images/process-tree-themes.png",
    "docs/images/process-tree-before-after.png",
    "docs/images/process-tree-states.png",
    "docs/verification/0.7.4.json",
    "docs/verification/0.8.2.json",
    "docs/verification/rc2-final-regression.json",
    "docs/images/code.png",
    "docs/verification/0.9.0.json",
    "docs/verification/0.9.1.json",
    "docs/images/function-code.png",
    "docs/verification/0.10.0.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "process-tree",
    "svg",
    "web-ui"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser-regressions.cjs",
    "test:host": "node test/host-compatibility.cjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bosaiting/dsh-process-tree.git"
  },
  "homepage": "https://github.com/Bosaiting/dsh-process-tree#readme",
  "bugs": {
    "url": "https://github.com/Bosaiting/dsh-process-tree/issues"
  }
}
